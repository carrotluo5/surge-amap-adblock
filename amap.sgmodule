#!name=高德地图去广告
#!desc=移除高德地图 App 的开屏广告、首页推广卡片与红点、搜索热词与结果推广、消息横幅、导航插播、打车页营销弹窗。纯脚本改写响应体，不拦截地图与导航正常接口。
#!system=ios
#!author=carrotluo5（脚本逻辑源自 RuCu6 / ddgksf2013）

[Script]
高德地图去广告-主接口 = type=http-response,pattern=^https:\/\/m5\.amap\.com\/ws(\/faas\/amap-navigation\/(main-page|card-service-plan-home|main-page-assets|main-page-location|card-service-car-end|card-service-route-plan|ridewalk-end-fc)([?&\/]|$)|\/aos\/main\/page\/product\/list([?&\/]|$)|\/valueadded\/(alimama\/splash_screen|weather\/v2)([?&\/]|$)|\/shield\/frogserver\/aocs\/updatable\/([?&\/]|$)|\/shield\/scene\/recommend([?&\/]|$)|\/message\/notice\/list([?&\/]|$)|\/shield\/search\/new_hotword([?&\/]|$)|\/shield\/search_bff\/hotword([?&\/]|$)|\/shield\/search_poi\/(homepage|sug|mps|search\/sp|tips_adv|tips_operation_location)([?&\/]|$)|\/shield\/search\/nearbyrec_smart([?&\/]|$)|\/shield\/search\/common\/coupon\/info([?&\/]|$)|\/shield\/search\/poi\/detail([?&\/]|$)|\/shield\/search_business\/process\/marketingOperationStructured([?&\/]|$)|\/mapapi\/hint_text\/offline_data([?&\/]|$)|\/aos\/perception\/publicTravel\/beforeNavi([?&\/]|$)|\/perception\/drive\/(routeInfo|routePlan)([?&\/]|$)|\/bus\/plan\/integrate([?&\/]|$)|\/c3frontend\/af-(launch|hotel)\/page\/main([?&\/]|$)|\/shield\/dsp\/profile\/index\/nodefaasv3([?&\/]|$)),requires-body=true,max-size=1048576,timeout=20,script-path=https://raw.githubusercontent.com/carrotluo5/surge-amap-adblock/main/amap.ads.js,script-update-interval=86400
高德地图去广告-消息 = type=http-response,pattern=^https:\/\/sns\.amap\.com\/ws(\/msgbox\/pull_mp([?&\/]|$)),requires-body=true,max-size=1048576,timeout=20,script-path=https://raw.githubusercontent.com/carrotluo5/surge-amap-adblock/main/amap.ads.js,script-update-interval=86400
高德地图去广告-打车 = type=http-response,pattern=^https:\/\/m5-zb\.amap\.com\/ws(\/boss\/(car\/order\/content_info|order_web\/friendly_information|order\/car\/king_toolbox_car_bubble|tips\/onscene_visual_optimization)([?&\/]|$)|\/promotion-web\/resource(\/home)?([?&\/]|$)|\/sharedtrip\/taxi\/order_detail_car_tips([?&\/]|$)),requires-body=true,max-size=1048576,timeout=20,script-path=https://raw.githubusercontent.com/carrotluo5/surge-amap-adblock/main/amap.ads.js,script-update-interval=86400
高德地图去广告-横幅 = type=http-response,pattern=^https:\/\/oss\.amap\.com\/ws(\/banner\/lists\/([?&\/]|$)),requires-body=true,max-size=1048576,timeout=20,script-path=https://raw.githubusercontent.com/carrotluo5/surge-amap-adblock/main/amap.ads.js,script-update-interval=86400

[MITM]
hostname = %APPEND% m5.amap.com, m5-zb.amap.com, sns.amap.com, oss.amap.com
